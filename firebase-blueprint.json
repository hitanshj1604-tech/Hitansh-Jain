{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Authenticated user profile with PII isolated to owner only",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "updatedAt"]
    },
    "BusinessLedger": {
      "title": "BusinessLedger",
      "description": "Top-level business financial ledger metadata owned by a signed-in user",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "segment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "referenceDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "segment",
        "location",
        "ownerName",
        "referenceDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Credit sale invoice and customer receivable record",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invoiceNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "customerPhone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "issueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "dueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "amount": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "lastPaymentDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "ledgerId",
        "invoiceNumber",
        "customerName",
        "customerCity",
        "customerPhone",
        "issueDate",
        "dueDate",
        "amount",
        "paidAmount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business operating expense or inventory purchase record",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ledgerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": [
            "Stock & Purchases",
            "Transport & Freight",
            "Rent & Utilities",
            "Staff & Salaries",
            "Marketing & Operations"
          ],
          "maxLength": 60
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "number"
        },
        "paymentMode": {
          "type": "string",
          "enum": ["UPI", "Bank Transfer", "Cash", "Cheque"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "ledgerId",
        "date",
        "title",
        "category",
        "vendor",
        "amount",
        "paymentMode",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private user account profile containing email and Google display details"
    },
    "/users/{userId}/ledgers/{ledgerId}": {
      "schema": { "$ref": "#/entities/BusinessLedger" },
      "description": "Business ledger settings and metadata owned by the authenticated user"
    },
    "/users/{userId}/ledgers/{ledgerId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Credit sale invoices and customer receivables under a user ledger"
    },
    "/users/{userId}/ledgers/{ledgerId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Business expense records under a user ledger"
    }
  }
}
